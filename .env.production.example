# ---------------------------------------------------------------------------
# Compublue -- production env for Vercel, with Postgres on Neon.
#
# Set these in Vercel > Project > Settings > Environment Variables (all three
# environments), NOT in a committed file. Redeploy after changing any of them:
# the NEXT_PUBLIC_* values and AUTH_SECRET are baked into the build output, so
# editing them without a rebuild leaves the app half-configured.
# ---------------------------------------------------------------------------

# Neon POOLED connection string -- the one whose host contains "-pooler".
# Serverless functions open connections aggressively; the direct (unpooled)
# string will exhaust Neon's connection limit under real traffic.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Public site URL, no trailing slash. Drives canonical tags, sitemap, OG tags,
# and decides whether the admin session cookie is marked `secure`.
NEXT_PUBLIC_SITE_URL="https://cumpusblue.vercel.app"

# Signs admin session tokens. Generate with: openssl rand -hex 32
# Changing this invalidates every existing admin session.
AUTH_SECRET="REPLACE-WITH-openssl-rand-hex-32"

# Seeded on the first `npm run migrate`. Change the password after first login.
ADMIN_EMAIL="admin@compublue.com"
ADMIN_PASSWORD="REPLACE-WITH-A-STRONG-PASSWORD"

# "1" sends X-Robots-Tag: noindex on every response. Use it while the site is
# on a preview URL so it cannot compete with compublue.com in search. Remove it
# (or set anything else) when this becomes the canonical site.
NEXT_PUBLIC_NOINDEX="1"

# Sub-path, only if the app is ever mounted under one (e.g. "/new"). Empty for
# a normal root deployment. Read at BUILD time.
NEXT_PUBLIC_BASE_PATH=""

# SMTP for lead notification emails (can also be set in the admin dashboard).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Compublue Website <no-reply@compublue.com>"
LEAD_NOTIFY_EMAIL="contact@compublue.com"

# Pexels API key (admin image search).
PEXELS_API_KEY=""

# Google reCAPTCHA v3. Blank disables verification; honeypot + rate limit stay.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE="0.5"
