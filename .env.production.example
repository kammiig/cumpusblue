# ---------------------------------------------------------------------------
# Compublue -- production env for cPanel, serving https://compublue.com/new
#
# Copy to `.env` in the application root ON THE SERVER, fill it in, and do this
# BEFORE running `npm run build`. Several of these values (NEXT_PUBLIC_*, and
# AUTH_SECRET as used by the edge middleware) are baked into the build output,
# so building first and editing after produces an app that half-uses the old
# values -- the usual symptom is an admin login that loops back to the form.
# ---------------------------------------------------------------------------

# MySQL from cPanel > MySQL Databases. Both names carry the cPanel user prefix.
# URL-encode any special characters in the password (@ = %40, # = %23, / = %2F).
DATABASE_URL="mysql://cpuser_compublue:PASSWORD@localhost:3306/cpuser_compublue"

# Mount point. Must match the Application URL sub-directory exactly, no
# trailing slash. Leave empty to serve from the domain root after go-live.
NEXT_PUBLIC_BASE_PATH="/new"

# Public site URL, including the sub-path -- drives canonical tags, the sitemap
# and Open Graph. Use https:// if AutoSSL is active (strongly recommended: the
# admin session cookie is only marked `secure` when this is https).
NEXT_PUBLIC_SITE_URL="https://compublue.com/new"

# "1" sends X-Robots-Tag: noindex on every response, keeping crawlers off the
# staged copy so it cannot cannibalise the live site in search. Any other value
# (or unset) disables it -- do that only when /new becomes the canonical site.
NEXT_PUBLIC_NOINDEX="1"

# Signs admin session tokens. Generate with: openssl rand -hex 32
# Changing this later invalidates every existing admin session.
AUTH_SECRET="REPLACE-WITH-openssl-rand-hex-32"

# Seeded on the first `npm run migrate`. Change the password after first login.
ADMIN_EMAIL="admin@compublue.com"
ADMIN_PASSWORD="REPLACE-WITH-A-STRONG-PASSWORD"

# SMTP for lead notification emails (can also be set in the admin dashboard).
# For a cPanel mailbox: host = mail.compublue.com, port 587 STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Compublue Website <no-reply@compublue.com>"
LEAD_NOTIFY_EMAIL="contact@compublue.com"

# Pexels API key (admin image search).
PEXELS_API_KEY=""

# Google reCAPTCHA v3 (contact form spam protection). Blank disables
# verification; the honeypot and rate limit still apply.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE="0.5"
